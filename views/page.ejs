<section class="store-toolbar" data-page-id="<%= pageId %>" data-page-slug="<%= pageSlug %>">
  <input type="text" id="search" placeholder="Search listings...">
  <button class="button add-listing-button" type="button" id="addListingBtn">+ Add Listing</button>
  <button class="button add-page-button" type="button" id="addPageBtn">+ Add Page</button>
</section>

<section class="section-heading">
  <div>
    <p class="eyebrow">StreamSuite collection</p>
    <h2><%= pageName %></h2>
  </div>
</section>

<div class="listing-grid" id="listingGrid" data-page-id="<%= pageId %>" data-page-slug="<%= pageSlug %>"></div>